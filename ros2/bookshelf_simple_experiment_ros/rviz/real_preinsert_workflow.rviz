Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 0.05
      Class: rviz_default_plugins/Grid
      Color: 125; 130; 138
      Enabled: true
      Name: Base Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: link_base
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: robot_description
      Enabled: true
      Name: Real xArm7
    - Class: moveit_rviz_plugin/MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Name: MotionPlanning
      Planning Group: xarm7
      Planning Request:
        Interactive Marker Size: 0
        Query Goal State: false
        Query Start State: false
        Show Workspace: false
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detected Slot and Preinsert Target
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /bookshelf_simple/markers
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Slot Detector Debug
      Normalize Range: true
      Queue Size: 2
      Topic: /slot_detector/debug_image
      Unreliable: false
      Value: true
    - Class: rviz_default_plugins/Pose
      Color: 255; 90; 60
      Enabled: true
      Name: Target TCP
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.008
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /bookshelf_simple/target_tcp_pose
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 1
      Marker Scale: 0.06
      Name: Frames
      Show Arrows: true
      Show Axes: true
      Show Names: false
  Enabled: true
  Global Options:
    Background Color: 31; 34; 39
    Fixed Frame: link_base
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.25
      Focal Point:
        X: 0.55
        Y: 0.05
        Z: 0.18
      Name: Bookshelf Real Preinsert
      Pitch: 0.3
      Target Frame: link_base
      Yaw: 3.14
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Slot Detector Debug:
    collapsed: false
  Views:
    collapsed: false
  Width: 1450
